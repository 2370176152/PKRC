持有物来自「持有物本」，变身道具（MEGA 石 / 石板等）也在其中。`,Je.tiny);return}const O=this.panelItemIcon(2,24,this.heldItemIcon(r),.75);this.panelText(O?28:2,27,this.markFormItem(r,Xa(r)),F.SUMMARY_GOLD,Je.small,$s.width-30);const I=s.heldItems[r]||0,S=Object.entries(s.heldItemAssignments??{}).filter(([,L])=>L===r).map(([L])=>{var h;return Ze(((h=s.pokemon[Number(L)])==null?void 0:h.selectedForm)??Number(L)).name});this.panelText(2,46,`库存 ${I} 件 · 已分配 ${S.length} · 可分配 ${Math.max(0,I-S.length)}`,F.WINDOW,Je.tiny),this.panelBar(2,55,$s.width-4,I>0?(I-S.length)/I:0,"hp"),S.length&&this.panelText(2,62,`持有者：${S.join("、")}`,F.WINDOW,Je.tiny);const T=this.describeItem(r);T&&this.panelParagraph(2,S.length?72:63,T,Je.tiny,F.WINDOW,$s.width-4,S.length?3:4)}};l(xV,"EryouHeldItemUiHandler");let sF=xV;const VV=class VV extends $l{constructor(){super(V.ERYOU_SYNTHESIS),this.rowInfo=[]}screenTitle(){return"养成 · 材料合成"}apply(s){return s.ok?(E.gameData.saveSystem(),this.notifyChanged(s.message)):this.getUi().playError(),s.message}stock(s,i){return dA.map((A,a)=>s.breakthroughMaterials[kE(i,a)]||0)}buildRows(){const s=E.gameData.getEryouData(),i=this.rootId,A=[],a=[];for(const r of dI(i)){const O=Vr(r),I=goe(s,i).filter(T=>T.type===r),S=I.some(T=>T.have>=KE);A.push({label:`一键合成 · ${O}`,state:S?"白→金":"材料不足",stateStyle:S?F.SUMMARY_GOLD:F.WINDOW,detail:`把${O}材料从最低档一路合到合不动（白→蓝→紫→金，每级 ${KE} 换 1）。合成有损（${KE} 个才换 1 个），只用来回收溢出的低级材料。`,enabled:S,run:l(()=>this.apply(jse(s,r)),"run")}),a.push({type:r});for(const T of I){const L=dA[T.from],h=dA[T.to],C=Math.floor(T.have/T.cost);A.push({label:`${O}：${L} → ${h}`,state:C>0?`可合成 ×${C}`:`${T.have}/${T.cost}`,stateStyle:C>0?F.SUMMARY_GOLD:F.WINDOW,detail:`消耗 ${L}色×${T.cost}，换成 ${h}色×1（单向不可逆，换不回来）。现有：${L}×${T.have}　${h}×${T.haveTarget}`,enabled:T.canSynthesize,run:l(()=>this.apply(HCe(s,T.type,T.from)),"run")}),a.push({type:r,option:T})}}return A.length||(A.push({label:"没有可合成的材料属性",detail:"材料合成按属性划分，只有自己属性的材料能用于突破。",enabled:!1,run:l(()=>"","run")}),a.push({type:0})),this.rowInfo=a,A}drawPanel(){const s=E.gameData.getEryouData(),i=this.rowInfo[this.cursor];if(!i)return;const A=i.type,a=this.stock(s,A);let r=a.slice();if(i.option)i.option.canSynthesize&&(r[i.option.from]-=i.option.cost,r[i.option.to]+=1);else{const L={...s,breakthroughMaterials:{...s.breakthroughMaterials}};jse(L,A),r=this.stock(L,A)}this.panelTypeBadge(2,1,A,.5),this.panelText(20,0,`${Vr(A)} · 突破材料库存`,F.SUMMARY_GOLD,Je.small,$s.width-22);const O=r.some((L,h)=>L!==a[h]);dA.forEach((L,h)=>{const C=12+h*11;this.panelText(2,C,`${L}色`,F.WINDOW,Je.small,22);const d=r[h]-a[h];this.panelText(26,C,O&&d!==0?`${a[h]} → ${r[h]}`:`${a[h]}`,F.WINDOW,Je.small,70),d!==0&&this.panelText(100,C,`${d>0?"+":""}${d}`,d>0?F.SUMMARY_GREEN:F.SUMMARY_RED,Je.small,30)}),this.panelText(2,57,`合成比例 ${KE} → 1（单向）`,F.SUMMARY_GRAY,Je.tiny);const I=KA(s,this.rootId),S=xl(I,this.rootId).materials.filter(L=>L.type===A);if(!S.length){this.panelText(2,70,"下一次突破不需要这个属性的材料。",F.WINDOW,Je.tiny);return}this.panelText(2,68,`下一次突破（第 ${I.breakthroughs+1} 次）需要：`,F.WINDOW,Je.tiny);let T=77;for(const L of S.slice(0,2))T=this.panelNeedRow(T,`${dA[L.rarity]}色${Vr(A)}材料（合成后）`,r[L.rarity],L.count)}};l(VV,"EryouSynthesisUiHandler");let iF=VV;const Ofe="二游模式 · 玩法说明",bI=[{title:"一、总览",lines:["· 【怎么返回】每个界面右上角都有「返回」按钮；","  也可以按 X / Esc，手机上从右向左滑动屏幕。","· 局外养成 + 副本 / 深渊，战斗沿用 P5X 速度制。","· 共 3 支预选队伍，每队 4 出战 + 1 解明，场上 4 打 6。","· 局内无经验、无商店、无抽选、无法捕捉。","· 个体值统一固定 15，不需要刷个体。","· 普通副本每场 3 波，深渊每层 10 波。","· 【倍速上限 8 倍】不管外面设置调多快，","  二游模式里最高只跑 8 倍速（退出后恢复）。","· 禁用 Z 招式：已解锁的 Z 招式蛋招进本时会被","  随机替换成另一个可学招式；","· 【隐藏平衡】深渊 7 层起敌方逐层变强（不在界面","  显示）：输出 ×1→×1.3、血量 ×1.3→×1.7。"]},{title:"二、编队与解明",lines:["· 第 1~4 位是出战位，第 5 位是【解明】。","· 解明永远不上场，只在场下提供增益。","· 解明把自己 15% 的属性分享给我方场上。","· 解明三招【进本即冷却】，不能第一回合就开；","  之后每有一名队友行动，全部冷却 -1 次。","· 即使三招全在冷却，「解明」按钮也常驻：","  点进去可查看剩余冷却与海之守护层数。","· 大厅左侧有 3 支预选队伍，↑↓ 上下换队看；","· 选中一队按 Z →「编队」进选人界面：点宝可梦","  按 Z →「加入队伍 N」，改完点右侧「保存」；","· 同一队按 Z →「选择」= 下本就用这队（★ 标记）。","· 右侧「搜索」可按编号 / 名字找宝可梦（支持中文）。"]},{title:"三、神兽 / 幻兽 / 异兽 / 悖论种",lines:["这些宝可梦照常显示、可以查看，但入队受限：","· 点亮它的解命命座 → 可作第 5 位【解明】。","· 【解明】只能在第 5 位。","· 用活动道具解锁过 → 获得出战位资格。","· 都没有 → 无法入队，界面会写明原因。","· 绿毛虫系的源龟虫 / 烈龟虫 / 固龙虫也按这一档处理。"]},{title:"四、养成 · 等级",lines:["· 初始 Lv.5，上限 Lv.30 起，最高 Lv.100。","· 整条进化链共享等级，进化不重置等级。","· 升级消耗普通糖 + PT，等级越高越贵。","  例：Lv.5~29 每级 2 糖 / 100 PT；","  Lv.90~100 每级 40 糖 / 2000 PT。","· 黄金糖 = 10 单位普通糖，会自动折算找零。"]},{title:"五、养成 · 突破",lines:["· 等级顶到上限时才能突破，共 7 次。","· 每突破一次等级上限 +10。","· 消耗本属性的突破材料（白/蓝/紫/金）+ PT。","· 材料来自材料本，属性与宝可梦一致。","· 例：第 1 次 白×5 + 2000 PT；","  第 7 次 紫×10 + 金×5 + 50000 PT。","· 溢出的低级材料可【合成】：5 个同级换 1 个","  上级（白→蓝→紫→金，单向不可逆）。","  入口：Z →「养成…」→「合成材料」。"]},{title:"六、养成 · 进化",lines:["· 一段进化需 Lv.20，二段进化需 Lv.50。","· 费用：3 基因 + 3000 PT / 8 基因 + 8000 PT。","· 基因属性 = 进化后形态的属性（双属性对半）。","· 道具进化额外 +2 基因。","· 进化后形态永久保留，可在进化页切换形态。","· 切换形态不影响等级 / 突破 / 招式。","· 变身形态（MEGA 等）要携带对应道具，进本后才会变身。"]},{title:"七、重置与持有物",lines:["· 重置养成：等级回 Lv.5、突破清零、","  形态还原为初始形态，需按两次确认。","· 糖 / PT / 突破材料 / 进化基因全额返还。","· 持有物一件同时只能给一只宝可梦。","· 库存不会因分配减少，卸下即释放。","· 持有物页支持按名字搜索（含中文输入）。","· 红牌：不再让对手退场，改为让攻击者","  下一轮最后出手（每波最多一次，不消耗）。","· 持有物合成（大厅）：5 件同球级回炉换 1 件，","  且有低概率升一档（普通 50% / 超级 35% /","  高级 15%，大师已到顶）；掺 1 件低一档的材料，","  升级与同级概率各 −15%，省下的概率会掉一档。"]},{title:"八、招式是怎么来的",lines:["· 配招：Z 菜单「管理招式」存过就按那套","  来（含蛋招商店换过的蛋招）；没存过则按","  当前等级自动配：已解锁蛋招优先，再用最","  近学会的 4 招补满 —— 进本永远是 4 招。","· 已解锁且启用的被动同样会继承。","· 招式池包含进化前的技能，所以进化不会","  让招式换一套，原来会的照旧在。","· 所有单位按速度排序出手，速度不够就没","  有出手权（画面右侧有出手顺序条）。"]},{title:"九、换人系招式的特殊处理",lines:["· 急速折返 / 伏特替换 / 快速折返 /","  抛下狠话 / 接棒 / 传送 / 断尾 /","  冷笑话：不换人，改为重新触发自己","  的登场效果（威吓等登场特性与被动会","  再发一次）。","· 因此击掌奇袭 / 掀榻榻米 / 首次印象","  这类「登场第一回合」限定招会被刷新：","  用过之后再用一次这类招式，下一轮","  又能放。","· 龙尾 / 吹飞 / 吼叫 / 巴投：不让对手","  退场，改为让被打中的目标下一轮最后","  一个出手，按被打中的先后排队。","· 原因：4+1 编制没有后备可换。"]},{title:"十、守住 · 强化与出手顺序",lines:["· 守住系（守住 / 看穿 / 王者盾牌 等）：","  改为选一名本方宝可梦，给它加持守住；","  只限我方使用，敌方用不出来。","· 守住成功率全队共享：本轮有人守住成功后，","  再用按 1/3、1/9… 判定，失败不叠加；","  跨轮保持，第 3 轮一定恢复 100%。","· 看我嘛 / 愤怒粉 / 聚光灯：点名一只敌方，","  它 2 轮内只能攻击施法者。","· 自我强化招（剑舞 / 变圆 等）：可选自己或队友。","· 广域防守 / 快速防守 / 掀榻榻米 / 戏法防守：全队生效。","· 陷阱甲壳：可直接打出，代价是下一轮最后出手。","· 延后：下一轮最后出手；您先请：下一轮最先出手。","· 突袭 / 快手还击 / 迅雷：上一个出手的是敌方则威力翻倍。"]},{title:"十一、誓约与招式改造",lines:["· 草 / 火 / 水之誓约：同一轮内队友再用另一","  招誓约即可组合（先手那发照常结算，后手","  那招升级成合体招式）。","· 治愈之愿 / 新月舞：改为选一只场上队友，","  由它接受全回复（自己仍会倒下）。","· 终焉之歌：本模式禁用（不能换人解倒计时）。","· 啄食 / 虫咬：吃果效果每波每只最多一次。","· 回收利用：让树果本波可以再触发一次。","· 拍落 / 烧净：让目标的树果这一波无法触发","  （道具不会被夺走）。"]},{title:"十二、群攻 · 禁用",lines:["· 打敌方全体的群攻招式（热风 / 暴风雪 /","  冲浪 / 地震 / 放电 等）出招前要先点一名","  敌方宝可梦作为【主目标】，选完照样打","  敌方全体，伤害与打击范围都不变。","· 冲浪 / 地震 / 放电这类原本会打到队友的","  群攻招式，本模式改为只打敌方全体。","· 大爆炸这类把自己算进去的保持原样。","· 召唤类招式（惩戒之壶等）全模式禁用，","  因为它们会召唤传说宝可梦直接上场。","· 本模式无法捕捉宝可梦。"]},{title:"十三、副本",lines:["· 材料本 / 经验本 / 持有物本 / PT 本。","· 各有 7 档难度，通关难度 N 解锁 N+1。","· 敌人等级：2 / 12 / 32 / 52 / 72 / 100 / 120。","· 难度 6 起会出现神兽 / 幻兽 / 异兽。","· 难度 7：敌方统一 Lv.120，并且带【血量 ×2】","  的面板 buff（血条上限真的翻倍），奖励为","  难度 6 的 1.5 倍。","· 经验本给糖，难度 3 起附带黄金糖。","· PT 本：3000 ~ 37500（±10%）。"]},{title:"十四、深渊",lines:["· 需先通关任意副本难度 4 才解锁入口。","· 共 10 层，每层 10 波，逐层解锁。","· 敌人 Lv.100 起，种族值下限逐层提高。","· 6 层起敌人带强化（攻/防/闪避/要害）。","· 【每周一凌晨 4:00 换阵容】6 层起每一层的","  敌人阵容 / 强化 / 特殊机制全网统一：","  同一周内所有玩家打同一层是同一套敌人。","· 9~10 层附加特殊机制（开局公示）：","  指定属性招式 -50%，物/特/单/群 -30%。","  机制生效期间会在我方血条下方显示图标，","  点一下图标可看具体压制了哪一项。","· 首通奖励【每周一凌晨 4:00 刷新】：","  刷新后每层可以再领一次首通奖励。"]},{title:"十五、觉醒石产出",lines:["· 首通：按层固定（1~6 颗不等）。","· 【每周刷新】首通奖励每周一凌晨 4:00 重置，","  重置后每层都能再领一次首通；","  已解锁层数、养成进度、命座都不受影响。","· 重复挑战（不限次，每层概率不同）：","  1~2 层：1% / 7% 概率掉 1 颗；","  3~5 层：8% / 9% / 12% 概率掉 1 颗；","  6 层：34% 概率掉 1 颗；","  7~8 层：固定 1 颗 + 39% / 47% 再掉 1 颗；","  9~10 层：固定 1 颗 + 75% / 82% 再掉 1 颗。","· 觉醒石用于点亮命座（解命等）。"]},{title:"十六、常见问题",lines:["Q：为什么只有 4 只上场？","A：P5X 规则 4 打 6，第 5 位解明不上场。","Q：为什么用急速折返没换人？","A：没有后备可换，改为重触发登场效果。","Q：守住为什么能加持给别人？","A：4 打 6 无后备，改为选一名本方宝可梦；","   只限我方使用，敌方用不出来。","Q：突袭 / 快手还击 / 迅雷怎么算威力？","A：上一个出手的是敌方宝可梦时威力翻倍。","Q：为什么初始是 5 级？","A：速度制下 1 级没有出手权，5 级刚好凑齐","   完整初始 4 招。"]},{title:"十七、尚未开放",lines:["· 活动：神兽等解锁资格的发放渠道。"]}],jo=22,zo=96,Fne=110;function kH(n){return n.replace(/\*\*/g,"")}l(kH,"plain");const kV=class kV extends Yi{