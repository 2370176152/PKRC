        if (spriteColors[i][3] == 0.0)
            break;
        if (texture.a > 0.0 && all(lessThan(abs(texture.rgb - spriteColors[i].rgb), vec3(0.5/255.0)))) {
            vec3 fusionColor = vec3(fusionSpriteColors[i].rgb) / 255.0;
